{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Svelte: Launch + Debug (sobe o vite dev)",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "svelte: dev",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///*": "*"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Svelte: Debug (dev server já rodando em :5173)",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Python: Litestar API (debug)",
      "module": "litestar",
      "args": ["--app", "app:create_app", "run"],
      "cwd": "${workspaceFolder}/backend/api",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONUTF8": "1" },
      "justMyCode": false
    }
  ]
}
